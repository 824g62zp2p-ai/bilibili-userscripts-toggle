{
  "$schema": "https://cdn.jsdelivr.net/npm/rollup-plugin-userscript-metablock@latest/userscript-metadata.schema.json",
  "name": "Bilibili Great Userscripts Toggle",
  "namespace": "https://github.com/824g62zp2p-ai/bilibili-userscripts-toggle",
  "grant": ["none"],
  "inject-into": "page",
  "run-at": "document-start",
  "match": [
    "https://www.bilibili.com/*",
    "https://player.bilibili.com/player.html*",
    "https://t.bilibili.com/*",
    "https://live.bilibili.com/*",
    "https://space.bilibili.com/*"
  ]
}
